# RobBob Telegram Backend Configuration
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000

# PostgreSQL Database
# Format: postgresql://username:password@hostname:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/robbob

# Telegram Bot Configuration
# Get bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Your bot's username (without @)
BOT_USERNAME=YourBotName

# Channel ID that users must join
# For public channels: @YourChannelName
# For private channels: -1001234567890 (get this from @userinfobot)
CHANNEL_ID=@YourChannelName
